# Copy to functions/.env for local use (git-ignored). In the cloud: npx supabase secrets set ...
# Gmail sender and Google app password (2-step verification must be on)
EMAIL=<sender gmail address>
EMAIL_PASSWORD=<google app password>
# Shared secret that callers must send in the header x-mail-secret (choose a long random value)
MAIL_FUNCTION_SECRET=<random string>
# Comma separated: only these addresses really receive mail, all others are simulated
MAIL_REAL_RECIPIENTS=gernotschulmeister28@gmail.com
