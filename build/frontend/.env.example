# Login: "mock" (simulated user with the "Acting as" switcher, default) or "supabase" (real login with Google or email/password)
VITE_AUTH_SOURCE=mock

# Data: "mock" (demo data in the browser, default) or "supabase" (not implemented yet)
VITE_DATA_SOURCE=mock

# Needed when VITE_AUTH_SOURCE or VITE_DATA_SOURCE is "supabase" (Project Settings -> API: Project URL and publishable/anon key)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
